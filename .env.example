# Copy to .env and fill in real values. Never commit .env.
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""


# Meta CAPI
# Public pixel ID, safe in the browser bundle.
VITE_META_PIXEL_ID="2151577492375386"
# Server-only. Set this as a Supabase secret, not as a VITE_ variable:
#   npx supabase secrets set META_ACCESS_TOKEN="..."
META_ACCESS_TOKEN=""
# Server-only. Must match VITE_META_PIXEL_ID, or the browser pixel and CAPI
# report to different datasets and Meta cannot deduplicate them:
#   npx supabase secrets set META_PIXEL_ID="2151577492375386"
META_PIXEL_ID="2151577492375386"

# Local-only override. Set it while running
#   npx supabase functions serve fb-capi --env-file supabase/functions/.env
# so the browser calls the local edge function instead of the deployed one.
# VITE_SUPABASE_FUNCTIONS_URL="http://127.0.0.1:54321/functions/v1"
